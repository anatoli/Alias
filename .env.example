# Environment / secrets template for Alias builds
# Copy values into GitHub Actions Variables / Secrets or a local .env (never commit secrets).

# Remote word bank (same shape as src/data/word-bank.json)
REACT_APP_WORDS_URL=https://YOUR_CDN/alias/word-bank.json

# AdMob interstitial ad unit (Android)
REACT_APP_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxx/yyyyyyyy

# Play Billing subscription product id (6 months, no ads)
REACT_APP_SUBSCRIPTION_PRODUCT_ID=alias_no_ads_6m
